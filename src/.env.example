# Copy this file to .env and adjust as needed. These are the settings the
# config package (story 03) will read. All are optional and have defaults.

# HTTP server port (story 11+)
PORT=8080

# Maximum accepted upload size, in bytes (10 MiB)
MAX_IMAGE_SIZE_BYTES=10485760

# Image dimension bounds (pixels)
MIN_IMAGE_WIDTH=1
MIN_IMAGE_HEIGHT=1
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000

# Where original uploads and generated variants are written
ORIGINALS_DIR=./data/originals
GENERATED_DIR=./data/generated

# How many variants of one image may be transformed at once (story 09)
MAX_CONCURRENT_TRANSFORMS=4

# HTTP timeouts (Go duration strings, e.g. 15s, 1m)
HTTP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
